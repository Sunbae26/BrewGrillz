NODE_ENV=development
PORT=4000
TRUST_PROXY=1
# Only when the API sits behind Cloudflare: cf-connecting-ip. Leave empty otherwise.
CLIENT_IP_HEADER=

# Neon: Dashboard → your project → Connect → copy the connection string (ends with ?sslmode=require)
DATABASE_URL=
DB_POOL_SIZE=10
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
MENU_CACHE_TTL_SECONDS=300

SITE_URL=http://localhost:5173

# Secrets. Locally these defaults are fine. On the live API, generate four different values with:
#   node -e "for (let i = 0; i < 4; i++) console.log(require('crypto').randomBytes(48).toString('base64url'))"
ORDER_TOKEN_SECRET=change-this-to-a-long-random-string
SESSION_SECRET=change-this-to-a-different-long-random-string
JWT_SECRET=change-this-to-a-third-long-random-string-for-the-app
# Owner account setup key. Not needed locally. On the live API: set it, create the owner at /admin/login, then remove it.
ADMIN_SETUP_KEY=
# How long people stay signed in
SESSION_DAYS=30
STAFF_SESSION_HOURS=12
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=60

# Rewards Club: 1 point per S$1; 100 points = S$5 off
POINTS_PER_DOLLAR=1
POINTS_REDEEM_BLOCK=100
POINTS_REDEEM_VALUE_CENTS=500

# Pickup ordering (Singapore time)
KITCHEN_OPEN=11:30
KITCHEN_CLOSE=22:30
PICKUP_PREP_MINUTES=30
PICKUP_SLOT_MINUTES=15
PICKUP_DAYS_AHEAD=7
PENDING_ORDER_EXPIRY_MINUTES=120

# Table bookings (Singapore time). Each booking holds a table for BOOKING_MINUTES.
TOTAL_TABLES=20
BOOKING_FIRST=11:30
BOOKING_LAST=21:30
BOOKING_STEP_MINUTES=30
BOOKING_MINUTES=120
BOOKING_LEAD_MINUTES=60
RESERVATION_DAYS_AHEAD=60
RESERVATION_MAX_ACTIVE=3
MAX_PARTY_SIZE=10

# test = the Pay button succeeds straight away (local only), stripe = real Stripe Checkout
PAYMENT_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# file = emails saved in backend/tmp/emails (open them in a browser), resend = send for real
EMAIL_PROVIDER=file
RESEND_API_KEY=
EMAIL_FROM=BrewGrillz <info@brewgrillz.sg>
EMAIL_REPLY_TO=
RESTAURANT_EMAIL=info@brewgrillz.sg

# off = no WhatsApp, file = save messages in backend/tmp/whatsapp, meta = send for real (launch)
WHATSAPP_PROVIDER=file
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en

SENTRY_DSN=
SENTRY_ENVIRONMENT=
