{
  "name": "brewgrillz-backend",
  "version": "0.1.0",
  "scripts": {
    "predev": "prisma migrate deploy && node --env-file-if-exists=.env prisma/seed.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "prestart": "prisma migrate deploy && node --env-file-if-exists=.env prisma/seed.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "email:test": "node --env-file-if-exists=.env scripts/send-test-email.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "db:seed:force": "node --env-file-if-exists=.env prisma/seed.js --force",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.5.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prisma": "^7.10.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
