# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database (Neon Postgres) ----------
# Pooled connection string (…-pooler…) for the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/brewgrillz?sslmode=require"
# Direct (non-pooled) connection string for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/brewgrillz?sslmode=require"

# ---------- Auth (Sprint 5) ----------
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Stripe (Sprint 3) ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Email via Resend (Sprint 3/4) ----------
RESEND_API_KEY=re_xxx
MAIL_FROM="BrewGrillz <hello@brewgrillz.sg>"
RESTAURANT_EMAIL=info@brewgrillz.sg

# ---------- WhatsApp (Sprint 3/4) ----------
WHATSAPP_ENABLED=false
