# Where the website calls the API. Locally: the backend on port 4000.
# On Vercel: /api (proxied by vercel.json, recommended) and set BUILD_API_URL too.
VITE_API_URL=http://localhost:4000/api
# Needed on Vercel when VITE_API_URL is /api: the build calls the API directly to pre-build the menu page.
BUILD_API_URL=
VITE_SITE_URL=https://www.brewgrillz.sg
